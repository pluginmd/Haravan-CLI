# Copy to .env and fill in your values, then run: docker compose up -d

# Haravan private-app access token (required for server-side use).
HARAVAN_ACCESS_TOKEN=your_haravan_access_token

# Host port mapping for the MCP HTTP/SSE endpoint.
HARAVAN_MCP_PORT=4567

# Optional overrides (uncomment to customise).
# HARAVAN_API_BASE=https://apis.haravan.com
# HARAVAN_WEBHOOK_BASE=https://webhook.haravan.com
# HARAVAN_LOG_LEVEL=info
